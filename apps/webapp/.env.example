# ---- Supabase -------------------------------------------------------------
# `supabase start` prints all three. The publishable key is safe in the browser;
# the secret key is not, and nothing prefixed NEXT_PUBLIC_ ever should be.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54621
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Where auth links point. Must match `site_url` in supabase/config.toml, and be
# an absolute URL: a redirect built from the request host drops cookies when the
# browser is on 127.0.0.1 and Next thinks it is localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Auth email hook ------------------------------------------------------
# Shared secret between Supabase and /api/auth/email. Supabase validates the
# FORMAT, so it must be `v1,whsec_<base64>` with at least 32 bytes — a plain
# string makes `supabase start` refuse to boot. Generate one with:
#   echo "v1,whsec_$(openssl rand -base64 32)"
# In production, use the value the dashboard generates for the hook.
AUTH_EMAIL_HOOK_SECRET=v1,whsec_REPLACE_ME_WITH_32_BYTES_BASE64

# ---- Google sign-in -------------------------------------------------------
# Read by supabase/config.toml, not by the app. Leave empty to hide nothing —
# the button will simply fail until these are set.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---- Email ----------------------------------------------------------------
# `smtp` sends to the local Mailpit instead of Resend. Unset it in production.
EMAIL_TRANSPORT=smtp
SMTP_PORT=54625
RESEND_API_KEY=
EMAIL_FROM="Agent on Trial <no-reply@example.com>"
EMAIL_REPLY_TO=

# ---- AI -------------------------------------------------------------------
# The AI Gateway is the only provider wiring there is: models are plain
# `provider/model` strings, so switching model is this one variable. On Vercel,
# OIDC covers the credential and AI_GATEWAY_API_KEY can stay unset.
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-5

# ---- Authentication policy ------------------------------------------------
# Email code and password login remain available; choose the initial screen.
AUTH_EMAIL_METHOD=password
# public | invite-only. Also set Supabase's Allow new users to sign up toggle.
AUTH_REGISTRATION=public
# Enable only after configuring Google in Supabase. Invite-only also requires
# disabling Supabase public signups so OAuth cannot provision new accounts.
AUTH_GOOGLE_ENABLED=false
# Hosted hook only: explicit additional origins for password links, comma-separated.
# AUTH_REDIRECT_ORIGINS=http://localhost:3000
# Expected deployed email endpoint used by setup:check --remote.
# AUTH_EMAIL_HOOK_URL=https://your-canonical-host/api/auth/email
# Optional management token for read-only remote configuration checks.
# SUPABASE_ACCESS_TOKEN=
